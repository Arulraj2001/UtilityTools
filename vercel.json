{
  "headers": [
    {
      "source": "/homepage-data.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public,s-maxage=3600,stale-while-revalidate=3600,stale-if-error=86400"
        }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(avif|webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/convert/:path*",
      "destination": "https://quickutils-conversion.onrender.com/api/convert/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://quickutils-api.onrender.com/api/admin/:path*"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "https://quickutils-api.onrender.com/api/cron/:path*"
    },
    {
      "source": "/api/homepage",
      "destination": "https://quickutils-api.onrender.com/api/homepage"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
