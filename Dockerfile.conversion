FROM node:20-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ghostscript \
    libreoffice \
    poppler-utils \
    python3 \
    python3-pip \
    qpdf \
    tesseract-ocr \
    tesseract-ocr-hin \
  && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --no-cache-dir pdf2docx ocrmypdf

COPY package*.json ./
RUN npm ci --omit=dev

COPY server ./server

EXPOSE 8787

CMD ["node", "server/conversion/server.js"]
